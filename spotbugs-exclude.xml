<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude SpotBugs warning for mutable Date/Timestamp returns in Model/DTO objects -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Exclude static connection pool management in DatabaseConnectionListener -->
    <Match>
        <Class name="com.arthy.arthymart.util.DatabaseConnectionListener"/>
        <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
    </Match>

    <!-- Servlets in Tomcat are managed by the servlet container lifecycle and not serialized -->
    <Match>
        <Package name="com.arthy.arthymart.servlet"/>
        <Bug pattern="SE_BAD_FIELD"/>
    </Match>

    <!-- Ignore ignored exceptions in close/rollback cleanup -->
    <Match>
        <Class name="com.arthy.arthymart.dao.OrderDAO"/>
        <Method name="createOrderWithItems"/>
        <Bug pattern="DE_MIGHT_IGNORE"/>
    </Match>
</FindBugsFilter>
