# ArthyMart Environment Configuration Template
# Copy this file to .env or configure via JVM system properties / environment variables

# Server Port
PORT=8080

# Database Configuration (Defaults to embedded in-memory H2)
# For persistent file mode: jdbc:h2:file:./arthymartdb;MODE=MySQL;AUTO_SERVER=TRUE
DB_URL=jdbc:h2:mem:arthymartdb;DB_CLOSE_DELAY=-1;MODE=MySQL
DB_USER=sa
DB_PASSWORD=

# Session Timeout in minutes
SESSION_TIMEOUT_MINUTES=30
